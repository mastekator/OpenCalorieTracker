{
  "name": "@oct/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/ && cp src/auth/common-passwords.txt dist/auth/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check-model": "tsx --conditions=development scripts/check-model.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.104",
    "@ai-sdk/google": "^4.0.120",
    "@ai-sdk/openai": "^4.0.117",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@hono/node-server": "^2.1.8",
    "@oct/shared": "workspace:*",
    "ai": "^7.0.172",
    "better-sqlite3": "^13.1.1",
    "hono": "^4.13.18",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  }
}
