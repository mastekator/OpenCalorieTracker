# Copy to .env and fill in. Never commit .env.

# Origin users open in the browser; https required except localhost.
PUBLIC_URL=http://localhost:3000

# Sign-in methods (comma-separated): password, passkey
AUTH_METHODS=password,passkey
# invite | open
REGISTRATION=invite

# Reverse proxies in front of the container that append X-Forwarded-For; 0 = socket address.
# With 1+, the container port must be reachable only by the proxy (see docker-compose.yml).
TRUST_PROXY_HOPS=1

# Owner of the data folder: the app runs as this user and group. On the host, `id` prints them
# (e.g. 1026 and 100 for the first user on a Synology NAS). Default 1000.
PUID=
PGID=

# Listen port inside the container (keep in sync with the ports mapping in docker-compose.yml).
PORT=3000
# Only affects log timestamps.
TZ=UTC

# AI provider: set it in the app, Settings -> AI provider.
# AI_* are optional; overrides the in-app settings.
# google | openai | anthropic | openrouter | openai-compatible (needs AI_BASE_URL, e.g. Ollama)
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=

# Requests to outside services (barcode lookup in Open Food Facts). Allowed by default; the admin
# can turn them off in the app. If set (true/false), overrides that switch.
# ALLOW_OUTBOUND_REQUESTS=

# Personal API tokens (scripts, Home Assistant, MCP). Allowed by default; the admin can turn them
# off in the app. If set (true/false), overrides that switch.
# ALLOW_API_TOKENS=

# Unattended install: the first admin from these instead of the setup wizard; used only on an
# empty database. The password needs 8-128 characters with a letter, a digit and a symbol;
# change it in the app after the first sign-in. Without them, the setup code is in the log.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
