# Copy to .env and fill in. Never commit .env.

# Origin users open in the browser; https required except localhost.
PUBLIC_URL=http://localhost:3000

# Sign-in methods (comma-separated): password, passkey
AUTH_METHODS=password,passkey
# invite | open
REGISTRATION=invite

# Initial admin, used only on an empty database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Reverse proxies in front of the container that append X-Forwarded-For; 0 = socket address.
TRUST_PROXY_HOPS=1

# Listen port inside the container (keep in sync with the ports mapping in docker-compose.yml).
PORT=3000
# Only affects log timestamps.
TZ=UTC

# AI provider (optional; without it the app works in manual mode).
# google | openai | anthropic | openrouter | openai-compatible (needs AI_BASE_URL, e.g. Ollama)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
