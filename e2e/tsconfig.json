{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Playwright loads the specs itself and resolves extensionless imports.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
